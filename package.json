{
  "name": "mindustry-calculator-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:static": "cross-env ELECTRON_BUILD=1 next build",
    "electron": "electron .",
    "dist:exe": "npm run build:static && electron-builder --win portable"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xyflow/react": "^12.8.2",
    "d3": "^7.9.0",
    "i18next": "^25.3.1",
    "next": "16.1.6",
    "pathfinding": "^0.4.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-resizable-panels": "^3.0.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/pathfinding": "^0.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.mindustry.mes",
    "productName": "Mindustry MES",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "out/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "MindustryMES-${version}-portable.exe"
    },
    "npmRebuild": false
  }
}
